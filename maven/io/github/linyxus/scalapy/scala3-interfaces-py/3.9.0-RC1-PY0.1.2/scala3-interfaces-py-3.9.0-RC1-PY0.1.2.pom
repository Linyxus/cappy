<?xml version='1.0' encoding='UTF-8'?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.linyxus.scalapy</groupId>
    <artifactId>scala3-interfaces-py</artifactId>
    <packaging>jar</packaging>
    <description>scala3-interfaces</description>
    <url>https://github.com/linyxus/scala3-py</url>
    <version>3.9.0-RC1-PY0.1.2</version>
    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <name>scala3-interfaces</name>
    <organization>
        <name>LAMP/EPFL</name>
        <url>http://lamp.epfl.ch</url>
    </organization>
    <scm>
        <url>https://github.com/linyxus/scala3-py</url>
        <connection>scm:git:git@github.com:linyxus/scala3-py.git</connection>
    </scm>
    <developers>
        <developer>
            <id>linyxus</id>
            <name>Yichen Xu</name>
            <url>https://github.com/linyxus</url>
        </developer>
    </developers>
    <properties>
        <info.scala.versionLine>Next</info.scala.versionLine>
        <info.versionScheme>semver-spec</info.versionScheme>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.github.sbt</groupId>
            <artifactId>junit-interface</artifactId>
            <version>0.13.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>