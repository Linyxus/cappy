#!/usr/bin/env bash

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" >& /dev/null && pwd)/.."

# Mirror the ScalaPy test-suite classpath so standalone compiles see the same
# stdlib, javalib/facade runtime, and link-time .pyir support jars.
scala_library_root="$ROOT/library/target/scala-library-bootstrapped"
scala_pylib_py_root="$ROOT/pylib-py/target/scala-pylib-py"
scala_library_py_root="$ROOT/library-py/target/scala-library-py"

find_jar() {
  # Pick the most recently built jar. Name-sorting is wrong when several
  # build-version dirs coexist (e.g. 3.8.5 vs 3.9.0), since the lexically
  # smaller — and usually older — version would win.
  find "$1" -type f -name "$2" ! -name "*-sources.jar" ! -name "*-javadoc.jar" -print0 2>/dev/null \
    | xargs -0 ls -t 2>/dev/null | head -1
}

# Succeeds (0) if any .scala/.java source under $1 is newer than jar $2, or if
# the jar is missing. Used to detect a support jar that has fallen behind its
# sources — the usual cause of "<symbol> resolved to a stub symbol" crashes.
sources_newer_than_jar() {
  local src_dir="$1" jar="$2"
  [ -d "$src_dir" ] || return 1
  [ -n "$jar" ] && [ -f "$jar" ] || return 0
  [ -n "$(find "$src_dir" -type f \( -name '*.scala' -o -name '*.java' \) -newer "$jar" -print -quit 2>/dev/null)" ]
}

resolve_scala_py_classpath() {
  local scala_library
  local scala_pylib_py
  local scala_library_py

  scala_library="$(find_jar "$scala_library_root" "scala-library-*.jar")"
  scala_pylib_py="$(find_jar "$scala_pylib_py_root" "scala-pylib-py_3-*.jar")"
  scala_library_py="$(find_jar "$scala_library_py_root" "scala-library-py_3-*.jar")"

  # Rebuild when a jar is missing, or when the py support sources have moved on
  # past their packaged jar. The py jars are cleaned before repackaging so a
  # stale, lexically-smaller version dir can't linger and shadow the fresh one.
  local need_library=0 need_py=0
  if [ -z "$scala_library" ] || [ ! -f "$scala_library" ]; then
    need_library=1
  fi
  if [ -z "$scala_pylib_py" ] || [ ! -f "$scala_pylib_py" ] ||
     sources_newer_than_jar "$ROOT/pylib-py/src" "$scala_pylib_py" ||
     [ -z "$scala_library_py" ] || [ ! -f "$scala_library_py" ] ||
     sources_newer_than_jar "$ROOT/library-py/src" "$scala_library_py"; then
    need_py=1
  fi

  if [ "$need_library" = "1" ] || [ "$need_py" = "1" ]; then
    local tasks=""
    [ "$need_library" = "1" ] && tasks="scala-library-bootstrapped/Compile/packageBin"
    if [ "$need_py" = "1" ]; then
      [ -n "$tasks" ] && tasks="$tasks; "
      tasks="${tasks}scala-pylib-py/clean; scala-pylib-py/Compile/packageBin; scala-library-py/clean; scala-library-py/Compile/packageBin"
    fi
    echo "Rebuilding ScalaPy support jars (missing or out of date with sources) ..." >&2
    (
      cd "$ROOT" &&
      sbt --client "$tasks"
    ) >&2 || exit 1

    scala_library="$(find_jar "$scala_library_root" "scala-library-*.jar")"
    scala_pylib_py="$(find_jar "$scala_pylib_py_root" "scala-pylib-py_3-*.jar")"
    scala_library_py="$(find_jar "$scala_library_py_root" "scala-library-py_3-*.jar")"
  fi

  if [ -z "$scala_library" ] || [ ! -f "$scala_library" ]; then
    echo "Could not locate scala-library jar under $scala_library_root" >&2
    exit 1
  fi
  if [ -z "$scala_pylib_py" ] || [ ! -f "$scala_pylib_py" ]; then
    echo "Could not locate scala-pylib-py jar under $scala_pylib_py_root" >&2
    exit 1
  fi
  if [ -z "$scala_library_py" ] || [ ! -f "$scala_library_py" ]; then
    echo "Could not locate scala-library-py jar under $scala_library_py_root" >&2
    exit 1
  fi

  printf '%s:%s:%s\n' "$scala_library" "$scala_pylib_py" "$scala_library_py"
}

need_scalapy_flag=1
for arg in "$@"; do
  case "$arg" in
    -scalapy|--scalapy)
      need_scalapy_flag=0
      break
      ;;
  esac
done

scala_py_classpath="$(resolve_scala_py_classpath)"

# Append ScalaPy support jars to any user-provided classpath so project-local
# outputs stay first, matching bin/scalac's merge behavior.
merged=()
injected=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -classpath|-cp)
      if [[ $# -lt 2 ]]; then
        merged+=("$1")
        shift
      else
        if [ -n "$2" ]; then
          merged+=("$1" "$2:$scala_py_classpath")
        else
          merged+=("$1" "$scala_py_classpath")
        fi
        shift 2
        injected=1
      fi
      ;;
    *)
      merged+=("$1")
      shift
      ;;
  esac
done

if [ "$injected" = "0" ]; then
  set -- -classpath "$scala_py_classpath" "${merged[@]}"
else
  set -- "${merged[@]}"
fi

if [ "$need_scalapy_flag" = "1" ]; then
  set -- -scalapy "$@"
fi

"$ROOT/bin/common" "scalac" "$@"
