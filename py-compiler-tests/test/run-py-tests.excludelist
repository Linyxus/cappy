i5441.scala                                 # float-mod-eval-order (println(b()%a()) before %.toFloat; semantic, not item 12 scope)
enum-java                                   # missing-driver (dir-test combines Java sources; .pyir not generated for Java)
enum-java-scala                             # missing-driver (dir-test combines Java sources)
